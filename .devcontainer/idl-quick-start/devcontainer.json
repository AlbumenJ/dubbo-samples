{
  "name": "Quick Start: Direct IDL Invoke",
  "image": "mcr.microsoft.com/devcontainers/java:0-17",

  "customizations": {
    "vscode": {
      "extensions": ["streetsidesoftware.code-spell-checker"]
    }
  },
  "postCreateCommand": [
    "./mvnw clean compile exec:java -pl 1-basic/dubbo-samples-idl -Dexec.mainClass=\"org.apache.dubbo.samples.tri.unary.TriUnaryServer\" > 1-basic/dubbo-samples-idl/server.log &",
    "code 1-basic/dubbo-samples-idl/README.md"
  ],
  "forwardPorts": [50051]
}
