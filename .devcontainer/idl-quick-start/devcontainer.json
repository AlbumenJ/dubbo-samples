{
  "name": "Quick Start: Direct IDL Invoke",
  "image": "mcr.microsoft.com/devcontainers/java:0-17",
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor",
        }
      }
    },
  },
  "postAttachCommand": {
    "server": [
      "1-basic/dubbo-samples-idl/launch-server.sh"
    ]
  },
  "forwardPorts": [
    50051
  ]
}
